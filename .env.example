# =============================================================================
# Innovip — variáveis de ambiente (EXEMPLO, sem valores reais)
# Copie para .env.local e preencha. Nunca faça commit de .env.local.
#
# NEXT_PUBLIC_*  → embutidas no bundle do navegador NO BUILD (públicas).
# Demais         → lidas só no servidor, em RUNTIME (segredos aqui).
# =============================================================================

# --- Site -------------------------------------------------------------------
# URL canônica (sem barra final). Dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Libera indexação no robots.txt. "true" só em produção, após o lançamento.
SITE_INDEXING_ENABLED=false

# --- Supabase ---------------------------------------------------------------
# Dashboard → Project Settings → API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave publishable (sb_publishable_...) ou anon legada. Pode ir ao navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_...) ou service_role legada (SUPABASE_SERVICE_ROLE_KEY).
# IGNORA RLS. Só servidor. Nunca com prefixo NEXT_PUBLIC.
SUPABASE_SECRET_KEY=

# Conexão Postgres direta — usada só por scripts locais e testes de RLS,
# nunca pela aplicação na Vercel. Dashboard → Connect → Session pooler.
# Use um projeto de desenvolvimento/teste, nunca produção.
DATABASE_URL=

# --- Medição (etapa 5) — ver docs/gtm-ga4-meta.md -----------------------------
# Só em PRODUÇÃO. Lidas no build: após mudar, faça novo deploy.
# Rastreamento liga apenas com TRACKING_ENABLED=true + GTM válido + VERCEL_ENV
# production (ou fora da Vercel). O GTM só carrega após consentimento.
NEXT_PUBLIC_GTM_ID=
TRACKING_ENABLED=false
# true libera o Tag Assistant na CSP, só para depurar. Desligar depois.
TRACKING_DEBUG=false
# Meta: Pixel é configurado DENTRO do GTM (não aqui). CAPI não implementada
# (agendamento externo: sem conversão persistida no site). Sem uso hoje:
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=
META_TEST_EVENT_CODE=

# --- Revalidação do cache público -----------------------------------------
# Segredo (32+ caracteres) do POST /api/revalidate, usado por scripts de
# manutenção que mudam conteúdo fora do painel. Vazio = endpoint desativado.
REVALIDATE_SECRET=

# --- Tarefas agendadas -----------------------------------------------------
# Reservado para tarefas agendadas futuras (sem uso hoje: não há outbox/CAPI).
CRON_SECRET=
